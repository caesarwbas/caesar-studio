---
import BaseLayout from "@/layouts/BaseLayout.astro";
const articles=["كيف تختار شركة تصميم مواقع؟","ما الفرق بين الموقع وتطبيق الويب؟","كيف تُبنى صفحات الخدمات المحلية دون محتوى مكرر؟","ما الذي يؤثر فعلاً في Core Web Vitals؟"];
---
<BaseLayout title="معرفة رقمية | CAESAR STUDIO" description="أدلة عملية عن تصميم المواقع والهوية والمنتجات الرقمية وSEO." lang="ar" path="/insights/">
  <section class="insights container" data-section="insights"><div class="eyebrow">INSIGHTS / PEOPLE-FIRST CONTENT</div><h1 class="display">معرفة تساعدك<br/>على القرار.</h1><div>{articles.map((title,i)=><article class="reveal"><small class="mono">0{i+1}</small><h2 class="display">{title}</h2><p>دليل تحريري أصلي سيُبنى من خبرة المشروع وأسئلة العملاء، لا من إعادة صياغة محتوى المنافسين.</p></article>)}</div></section>
</BaseLayout>
<style>.insights{padding:150px 0}.insights>h1{margin:18px 0 60px;font-size:clamp(60px,9vw,135px);line-height:.9}.insights>div:last-child{border-top:1px solid var(--line)}article{display:grid;grid-template-columns:55px 1fr minmax(240px,.5fr);align-items:center;gap:25px;min-height:150px;border-bottom:1px solid var(--line)}small{color:var(--accent)}h2{font-size:clamp(25px,3vw,42px)}p{color:var(--muted);line-height:1.7}@media(max-width:720px){article{grid-template-columns:35px 1fr}article p{display:none}}</style>
