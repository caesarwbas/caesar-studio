---
import BaseLayout from "@/layouts/BaseLayout.astro";
import LocalServiceLanding from "@/components/LocalServiceLanding.astro";
import { services } from "@/data/services"; import { locations } from "@/data/locations"; import { getSeoCopy } from "@/data/seo-content";
import { breadcrumbSchema, faqSchema, serviceSchema, webPageSchema } from "@/lib/seo-schema";
export function getStaticPaths(){return locations.flatMap((location)=>services.map((service)=>({params:{city:location.slug,service:service.slug},props:{location,service}})))}
const {location,service}=Astro.props; const copy=getSeoCopy(service.slug); const path=`/locations/${location.slug}/${service.slug}/`;
const title=`${service.ar} في ${location.ar} | CAESAR STUDIO`; const description=`${copy.arIntro} ${location.arMarket}`;
const crumbs=[{name:"الرئيسية",href:"/"},{name:location.ar,href:`/locations/${location.slug}/`},{name:service.ar,href:path}];
const faq=[{q:`هل تقدمون ${service.ar} في ${location.ar}؟`,a:`نعم، تُدار الخدمة رقميًا وتُكيّف مع سوق ${location.ar}.`},{q:`ما الذي يختلف في مشروع ${location.ar}؟`,a:location.arMarket},{q:"هل السعر ثابت؟",a:`يتغير حسب ${copy.arFactors.join("، ")}.`}];
const schema=[webPageSchema(path,title,description,"ar"),serviceSchema(service,copy,path,"ar",location),breadcrumbSchema(crumbs),faqSchema(faq)];
---
<BaseLayout title={title} description={description} lang="ar" path={path} alternatePath={`/en/locations/${location.slug}/${service.slug}/`} schema={schema} dateModified="2026-08-13"><LocalServiceLanding service={service} location={location} lang="ar"/></BaseLayout>
