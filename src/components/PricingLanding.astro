---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import FaqList from "@/components/FaqList.astro";
import ContactCta from "@/components/ContactCta.astro";
import SeoLinkGrid from "@/components/SeoLinkGrid.astro";
import { locations } from "@/data/locations"; import { getSeoCopy } from "@/data/seo-content";
const {service,lang="ar"}=Astro.props; const ar=lang==="ar"; const prefix=ar?"":"/en"; const copy=getSeoCopy(service.slug);
const name=ar?service.ar:service.en; const factors=ar?copy.arFactors:copy.enFactors; const deliverables=ar?copy.arDeliverables:copy.enDeliverables;
const path=`${prefix}/prices/${service.slug}/`; const faq=ar?[{q:`كم تبلغ تكلفة ${name}؟`,a:"لا يوجد سعر واحد صالح لكل مشروع. بعد جلسة قصيرة نحدد النطاق ثم نرسل عرضًا يوضح المراحل والتسليمات والتكلفة."},{q:"ما الذي يرفع أو يخفض التكلفة؟",a:`العوامل الأساسية هي ${factors.join("، ")}.`},{q:"هل العرض يتضمن التنفيذ؟",a:`يحدد العرض بوضوح ما إذا كان يشمل ${deliverables.join("، ")}.`}]:[{q:`How much does ${name} cost?`,a:"There is no honest universal price. We define scope after a short discovery call and provide a proposal covering phases, deliverables, and cost."},{q:"What changes the cost?",a:`The main factors are ${factors.join(", ")}.`},{q:"Does the proposal include delivery?",a:`The proposal clearly states whether it includes ${deliverables.join(", ")}.`}];
const markets=locations.map((location)=>({name:`${name} ${ar?"في":"in"} ${ar?location.ar:location.en}`,href:`${prefix}/locations/${location.slug}/${service.slug}/`,note:ar?location.arMarket:location.enMarket}));
---
<Breadcrumbs items={[{name:ar?"الرئيسية":"Home",href:`${prefix}/`},{name:ar?"دليل الأسعار":"Pricing guides",href:path},{name,href:path}]}/>
<section class="price-hero container"><div class="eyebrow">PRICING GUIDE / SCOPE FIRST</div><h1 class="display">{ar?`تكلفة ${name}`:`${name} pricing`}</h1><p>{ar?"نشرح ما يصنع السعر حتى تقارن العروض على أساس النطاق والقيمة، لا على رقم مبتور.":"Understand what drives cost so proposals can be compared by scope and value, not an isolated number."}</p><a class="button primary interactive" href="#contact">{ar?"اطلب عرضًا محدد النطاق":"Request a scoped proposal"}<span>↗</span></a></section>
<section class="price-grid container"><article><small>01</small><h2>{ar?"ما يدخل في التسليم":"What delivery can include"}</h2>{deliverables.map((item)=><p>— {item}</p>)}</article><article><small>02</small><h2>{ar?"ما يحدد الاستثمار":"What determines investment"}</h2>{factors.map((item)=><p>— {item}</p>)}</article><article><small>03</small><h2>{ar?"طريقة التسعير":"Pricing method"}</h2><p>{ar?"نطاق واضح، مراحل قابلة للمراجعة، ومخرجات محددة. لا نعرض أرقامًا مصطنعة لمحركات البحث.":"Clear scope, reviewable phases, and defined outputs. We do not publish fabricated figures for search engines."}</p></article></section>
<SeoLinkGrid title={ar?"الخدمة حسب السوق":"Service by market"} items={markets}/><FaqList items={faq}/><ContactCta lang={lang}/>
<style>.price-hero{min-height:70vh;padding-top:110px;display:flex;flex-direction:column;justify-content:center}.price-hero h1{margin:18px 0;font-size:clamp(55px,8vw,128px);line-height:.92}.price-hero p{max-width:760px;color:var(--muted);font-size:19px;line-height:1.9}.price-hero>a{width:max-content;margin-top:24px}.price-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:20px 0 80px}.price-grid article{min-height:260px;padding:26px;border:1px solid var(--line);border-radius:24px;background:var(--surface)}.price-grid small{color:var(--accent)}.price-grid h2{font-size:27px}.price-grid p{color:var(--muted);line-height:1.75}@media(max-width:760px){.price-grid{grid-template-columns:1fr}.price-hero h1{font-size:clamp(46px,14vw,75px)}}</style>
