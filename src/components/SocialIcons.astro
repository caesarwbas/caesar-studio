---
const icons = [
  { label: "Facebook", brand: "#1877f2", path: "M14 21v-8h3l.5-4H14V7.2c0-1.2.4-2.2 2.4-2.2H19V2h-3.5C12 2 10 4.1 10 7v2H7v4h3v8", href: "https://www.facebook.com/caesar.studio5" },
  { label: "Instagram", brand: "#e1306c", path: "M8 3h8a5 5 0 0 1 5 5v8a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5V8a5 5 0 0 1 5-5Zm4 5.1a3.9 3.9 0 1 0 0 7.8 3.9 3.9 0 0 0 0-7.8ZM17.5 6.5h.01", href: "https://www.instagram.com/caesarstudio5/" },
  { label: "LinkedIn", brand: "#0a66c2", path: "M6.5 8.2V18M6.5 5.2v.1M10.8 18v-5.4c0-2.1 3.8-2.3 3.8.2V18M10.8 10.2v7.8", href: "" },
  { label: "YouTube", brand: "#ff0033", path: "M21 8.2a2.7 2.7 0 0 0-1.9-1.9C17.4 6 12 6 12 6s-5.4 0-7.1.3A2.7 2.7 0 0 0 3 8.2 28 28 0 0 0 2.7 12 28 28 0 0 0 3 15.8a2.7 2.7 0 0 0 1.9 1.9C6.6 18 12 18 12 18s5.4 0 7.1-.3a2.7 2.7 0 0 0 1.9-1.9 28 28 0 0 0 .3-3.8 28 28 0 0 0-.3-3.8ZM10 15V9l5 3-5 3Z", href: "" },
  { label: "X", brand: "#111111", path: "M5 4l14 16M19 4 5 20", href: "" },
];
---
<div class="social-card" aria-label="Social media">
  {icons.map(({ label, brand, path, href }) => (
    <div class="social-icon" style={`--brand:${brand}`}>
      <p role="tooltip">{label}</p>
      {href ? (
        <a class="icon-target" href={href} target="_blank" rel="noopener noreferrer" aria-label={label}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={path}></path></svg>
        </a>
      ) : (
        <span class="icon-target" role="img" aria-label={label}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={path}></path></svg>
        </span>
      )}
    </div>
  ))}
</div>
<style>
  .social-card{display:flex;align-items:center;justify-content:space-around;width:min(310px,calc(100vw - 40px));height:62px;padding-inline:15px;border:1px solid rgba(255,255,255,.55);border-radius:115px;background:rgba(245,245,245,.92);box-shadow:inset 0 1px 1px #fff,inset 0 8px 18px rgba(255,255,255,.48),0 12px 35px rgba(0,0,0,.26);backdrop-filter:blur(18px) saturate(1.25)}
  .social-icon{position:relative;display:flex;align-items:center;justify-content:center;width:42px;height:48px;transition:filter .45s,transform .45s,opacity .45s}
  .icon-target{width:38px;height:38px;display:grid;place-items:center;border:1px solid rgba(0,0,0,.12);border-radius:50%;color:#171717;text-decoration:none;background:linear-gradient(145deg,#fff,#d9d9d9);box-shadow:inset 0 1px 1px #fff,inset 0 4px 8px rgba(255,255,255,.65),0 5px 10px rgba(0,0,0,.18);transition:color .35s,transform .35s,box-shadow .35s,border-color .35s}
  .social-icon p{position:absolute;z-index:3;top:0;margin:0;padding:5px 9px;border-radius:7px;color:#fff;background:var(--brand);font:700 10px/1.15 "Space Grotesk",sans-serif;opacity:0;white-space:nowrap;pointer-events:none;transform:translateY(0) scale(.85);transition:opacity .35s,transform .55s cubic-bezier(.2,.8,.2,1)}
  .social-icon p::after{content:"";position:absolute;top:100%;left:50%;border-top:7px solid var(--brand);border-inline:5px solid transparent;transform:translateX(-50%)}
  .social-icon:hover p,.social-icon:focus-within p{opacity:1;transform:translateY(-42px) scale(1)}
  .social-icon:hover .icon-target,.social-icon:focus-within .icon-target{color:var(--brand);border-color:color-mix(in srgb,var(--brand) 58%,white);transform:translateY(-3px) scale(1.12);box-shadow:inset 0 1px 1px #fff,0 0 0 2px color-mix(in srgb,var(--brand) 24%,transparent),0 0 18px color-mix(in srgb,var(--brand) 62%,transparent)}
  .social-card:hover>.social-icon:not(:hover){filter:blur(3px);transform:scale(.8);opacity:.48}
  .social-card svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
  @media(max-width:420px){.social-card{width:min(280px,calc(100vw - 32px));padding-inline:10px}.social-icon{width:38px}.icon-target{width:35px;height:35px}}
  @media(prefers-reduced-motion:reduce){.social-icon,.icon-target,.social-icon p{transition:none}}
</style>
