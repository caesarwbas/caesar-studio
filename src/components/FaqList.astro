---
const { items = [] } = Astro.props;
---
<section class="faq container"><div class="eyebrow">FAQ / ANSWERS</div><h2 class="section-title display">الأسئلة الشائعة</h2><div>{items.map((item:any) => <details><summary>{item.q}<span>+</span></summary><p>{item.a}</p></details>)}</div></section>
<style>.faq{padding:110px 0}.faq>div:last-child{margin-top:42px;border-top:1px solid var(--line)}details{border-bottom:1px solid var(--line);padding:0 6px}summary{min-height:82px;display:flex;justify-content:space-between;align-items:center;gap:20px;cursor:pointer;font-size:20px;font-weight:700;list-style:none}summary::-webkit-details-marker{display:none}summary span{color:var(--accent);font-size:28px}p{max-width:800px;margin:0 0 28px;color:var(--muted);line-height:1.85}</style>
