---
const {item,index=0}=Astro.props;
const splitBalanced=(value:string)=>{
  const words=value.trim().split(/\s+/); if(words.length<2)return [value,"\u00a0"];
  let cut=1; let difference=Infinity;
  for(let i=1;i<words.length;i++){const next=Math.abs(words.slice(0,i).join(" ").length-words.slice(i).join(" ").length);if(next<difference){difference=next;cut=i}}
  return [words.slice(0,cut).join(" "),words.slice(cut).join(" ")];
};
const first=splitBalanced(item.name);
---
<a class="button" data-native-button href={item.href} aria-label={item.name}>
  <span class="bg"></span>
  <svg fill="none" viewBox="0 0 342 208" class="splash" aria-hidden="true">
    <path d="M54.1054 99.7837S40.0984 90.7874 26.6893 97.6362 1.5 97.6362 1.5 97.6362"/><path d="M285.273 99.7841S299.28 90.7879 312.689 97.6367 340.105 95.4893 340.105 95.4893"/>
    <path opacity=".3" d="M281.133 64.9917S287.96 49.8089 302.934 48.2295 319.712 36.5272 319.712 36.5272"/><path opacity=".3" d="M281.133 138.984S287.96 154.167 302.934 155.746 319.712 167.449 319.712 167.449"/>
    <path d="M230.578 57.4476S225.785 41.5051 236.061 30.4998 244.686 12.9998 244.686 12.9998"/><path d="M230.578 150.528S225.785 166.471 236.061 177.476 244.686 194.976 244.686 194.976"/>
    <path opacity=".3" d="M170.392 57.0278S173.89 42.1322 169.571 29.54 168.751 2.05227 168.751 2.05227"/><path opacity=".3" d="M170.392 150.948S173.89 165.844 169.571 178.436 168.751 205.924 168.751 205.924"/>
    <path d="M112.609 57.4476S117.401 41.5051 107.125 30.4998 98.5 12.9998 98.5 12.9998"/><path d="M112.609 150.528S117.401 166.471 107.125 177.476 98.5 194.976 98.5 194.976"/>
    <path opacity=".3" d="M62.2941 64.9917S55.4671 49.8089 40.4932 48.2295 23.7159 36.5272 23.7159 36.5272"/><path opacity=".3" d="M62.2941 145.984S55.4671 161.167 40.4932 162.746 23.7159 174.449 23.7159 174.449"/>
  </svg>
  <span class="wrap"><svg fill="none" viewBox="0 0 221 42" class="path" aria-hidden="true"><path d="M182.674 2H203C211.837 2 219 9.16344 219 18V24C219 32.8366 211.837 40 203 40H18C9.16345 40 2 32.8366 2 24V18C2 9.16344 9.16344 2 18 2H47.8855"/></svg><span class="outline"></span><span class="content">
    <span class="char state-1">{first.map((line,i)=><span class="button-line" style={`--i:${i+1}`}>{line}</span>)}</span><span class="icon"><span></span></span>
  </span></span><span class="search-meta">{String(index+1).padStart(2,"0")} · {item.city}</span>
</a>
<style>
.button{--white:#fff4e8;--purple-100:#ffd6a3;--purple-200:#ffad5c;--purple-300:#ff8a2a;--purple-400:#e95416;--purple-500:#8f2708;--radius:18px;border-radius:var(--radius);outline:none;cursor:pointer;font-size:16px;font-family:"IBM Plex Sans Arabic","Alexandria",Arial,sans-serif;background:transparent;border:0;position:relative;width:220px;height:88px;display:block;text-decoration:none;transform:rotate(353deg) skewX(4deg)}
.bg{position:absolute;inset:0;border-radius:inherit;filter:blur(1px)}.bg::before,.bg::after{content:"";position:absolute;inset:0;border-radius:calc(var(--radius)*1.1);background:var(--purple-500)}.bg::before{filter:blur(5px);transition:.3s ease;box-shadow:-7px 6px 0 rgb(211 70 15/.4),-14px 12px 0 rgb(211 70 15/.3),-21px 18px 4px rgb(211 70 15/.25),-28px 24px 8px rgb(211 70 15/.15),-35px 30px 12px rgb(211 70 15/.12),-42px 36px 16px rgb(211 70 15/.08),-56px 42px 20px rgb(211 70 15/.05)}
.wrap{border-radius:inherit;overflow:hidden;height:100%;display:block;transform:translate(6px,-6px);padding:3px;background:linear-gradient(var(--purple-100),var(--purple-400));position:relative;transition:.3s ease}.outline{position:absolute;overflow:hidden;inset:0;opacity:0;border-radius:inherit;transition:.4s ease}.outline::before{content:"";position:absolute;inset:2px;width:120px;height:300px;margin:auto;background:linear-gradient(90deg,transparent,white,transparent);animation:spin 3s linear infinite paused}
.content{pointer-events:none;display:flex;align-items:center;justify-content:center;z-index:1;position:relative;height:100%;gap:10px;border-radius:calc(var(--radius)*.85);font-weight:800;transition:.3s ease;background:linear-gradient(var(--purple-300),var(--purple-400));box-shadow:inset -2px 12px 11px -5px var(--purple-200),inset 1px -3px 11px rgb(0 0 0/.35)}.content::before{content:"";inset:45% 10% 35%;position:absolute;z-index:10;opacity:.7;background:linear-gradient(transparent,var(--purple-400));filter:brightness(1.3) blur(5px)}
.char{transition:.3s ease;display:flex;align-items:center;justify-content:center;white-space:pre;direction:rtl}.char span{display:block;color:transparent;position:relative}.char.state-1{flex-direction:column;width:calc(100% - 54px);max-width:145px;font-size:14px;line-height:1.4;letter-spacing:0;text-align:center}.char.state-1 .button-line{color:var(--white);width:100%;white-space:nowrap;text-shadow:0 1px 3px var(--purple-500);animation:lineEnter .7s ease backwards calc(var(--i)*.09s)}
.icon{animation:resetArrow .8s cubic-bezier(.7,-.5,.3,1.2) forwards;z-index:10}.icon span,.icon span::before,.icon span::after{height:3px;border-radius:1px;background:var(--white)}.icon span{position:relative;display:block;width:24px;box-shadow:-2px 2px 5px var(--purple-400);transform:scale(.9);background:linear-gradient(var(--white),var(--purple-100));animation:swingArrow 1s ease-in-out infinite paused}.icon span::before,.icon span::after{content:"";position:absolute;right:0;transform-origin:center right;width:14px;transition:.3s ease}.icon span::before{transform:rotate(44deg);top:1px;animation:rotateArrowLine 1s linear infinite paused}.icon span::after{bottom:1px;transform:rotate(316deg);animation:rotateArrowLine2 1s linear infinite paused}
.path{position:absolute;z-index:12;bottom:0;left:0;width:100%;height:42px;stroke:var(--white);stroke-width:3;stroke-linecap:round;stroke-dasharray:150 480;stroke-dashoffset:150;pointer-events:none}.splash{position:absolute;top:0;left:0;width:342px;height:208px;pointer-events:none;stroke-dasharray:60 60;stroke-dashoffset:60;transform:translate(-17%,-31%);stroke:var(--purple-300);stroke-width:3;stroke-linecap:round}.search-meta{position:absolute;top:102px;left:50%;width:max-content;transform:translateX(-50%) rotate(7deg) skewX(-4deg);color:var(--purple-100);font:600 9px "Space Mono";letter-spacing:2px;opacity:.7}
.button:hover .button-line{transform:translateY(-1px);text-shadow:0 0 7px #fff,0 0 13px var(--purple-200)}.button:hover .wrap{transform:translate(8px,-8px)}.button:hover .outline{opacity:1}.button:hover .outline::before,.button:hover .icon span::before,.button:hover .icon span::after,.button:hover .icon span{animation-play-state:running}.button:active .bg::before{filter:blur(5px);opacity:.7;box-shadow:-7px 6px 0 rgb(211 70 15/.4),-14px 12px 0 rgb(211 70 15/.25),-21px 18px 4px rgb(211 70 15/.15)}.button:active .content{box-shadow:inset -1px 12px 8px -5px rgb(128 34 3/.4),inset 0 -3px 8px var(--purple-200)}.button:active .outline{opacity:0}.button:active .wrap{transform:translate(3px,-3px)}.button:active .splash{animation:splash .8s cubic-bezier(.3,0,0,1) forwards .05s}.button:focus .path{animation:path 1.6s ease forwards .2s}.button:focus .icon{animation:arrow 1s cubic-bezier(.7,-.5,.3,1.5) forwards}
@keyframes spin{to{transform:rotate(360deg)}}@keyframes lineEnter{from{transform:translateY(8px);opacity:0;filter:blur(6px)}}@keyframes arrow{0%{opacity:1}50%{transform:translateX(60px);opacity:0}51%{transform:translateX(-200px);opacity:0}100%{transform:translateX(-128px);opacity:1}}@keyframes swingArrow{50%{transform:translateX(5px) scale(.9)}}@keyframes rotateArrowLine{50%{transform:rotate(30deg)}80%{transform:rotate(55deg)}}@keyframes rotateArrowLine2{50%{transform:rotate(330deg)}80%{transform:rotate(300deg)}}@keyframes resetArrow{from{transform:translateX(-128px)}to{transform:translateX(0)}}@keyframes path{from{stroke:white}to{stroke-dashoffset:-480;stroke:#ffe0bd}}@keyframes splash{to{stroke-dasharray:2 60;stroke-dashoffset:-60}}
</style>
