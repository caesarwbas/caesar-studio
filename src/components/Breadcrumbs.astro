---
const { items = [] } = Astro.props;
---
<nav class="breadcrumbs container mono" aria-label="Breadcrumb">{items.map((item:any,index:number) => <><a id={`breadcrumb-${index}`} href={item.href}>{item.name}</a>{index < items.length - 1 && <span>/</span>}</>)}</nav>
<style>.breadcrumbs{display:flex;gap:10px;padding-top:118px;color:var(--muted);font-size:9px}.breadcrumbs a{color:inherit;text-decoration:none}.breadcrumbs a:hover{color:var(--text)}</style>
