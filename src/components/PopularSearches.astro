---
import SearchSplashButton from "@/components/SearchSplashButton.astro";
import { services } from "@/data/services"; import { locations } from "@/data/locations";
const {lang="ar"}=Astro.props; const ar=lang==="ar"; const prefix=ar?"":"/en";
const pairs=[[0,0],[8,0],[5,1],[0,1],[3,2],[2,2],[1,3],[8,3],[4,1],[7,2],[6,0],[5,2]];
const items=pairs.map(([serviceIndex,locationIndex])=>{const service=services[serviceIndex];const location=locations[locationIndex];return{name:`${ar?service.ar:service.en} ${ar?"في":"in"} ${ar?location.ar:location.en}`,href:`${prefix}/locations/${location.slug}/${service.slug}/`,city:ar?location.ar:location.en}});
const cubeColumns=[-1,0,1]; const cubeRows=[3,2,1]; const cubeSets=[0,1,2];
---
<section class="popular" id="popular-searches" aria-labelledby="popular-title">
  <div class="popular-inner container">
    <header class="popular-heading"><span class="eyebrow">SEARCH INTENT / SERVICE × MARKET</span><h2 class="popular-title-sign" id="popular-title"><span>{ar?"الأكثر بحثًا":"Popular searches"}</span></h2><p>{ar?"مسارات مباشرة إلى أكثر الخدمات طلبًا في الأسواق التي نخدمها.":"Direct paths to the most requested services across the markets we serve."}</p></header>
    <div class="popular-body">
      <div class="search-grid">{items.map((item,index)=><SearchSplashButton item={item} index={index}/>)}</div>
      <div class="cube-stage" data-cube-stage aria-label={ar?"مجسم مكعب تفاعلي":"Interactive cube sculpture"}>
        <div class="cube-motion" data-cube-motion><div class="cube-container">
          {cubeSets.map(()=><div class="cube">{cubeColumns.map(x=><div style={`--x:${x};--y:0`}>{cubeRows.map(i=><span style={`--i:${i}`}></span>)}</div>)}</div>)}
        </div></div>
      </div>
    </div>
  </div>
</section>
<style>
.popular{position:relative;padding:125px 0 165px;overflow:hidden;isolation:isolate}.popular::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(12,8,10,.5),rgba(16,11,13,.82));z-index:-1}.popular-inner{position:relative;z-index:2;max-width:1540px}.popular-heading{text-align:center;display:grid;justify-items:center;margin-bottom:70px}.popular-title-sign{height:4.5rem;width:17rem;margin:24px 0 82px;display:grid;place-items:center;border-radius:5px;border:5px solid #fff;filter:drop-shadow(0 0 10px #fff);animation:popularFlicker 2s linear infinite both;background:#535252;color:#eaeaea;box-shadow:0 0 60px #1f4c65;-webkit-box-reflect:below 10px linear-gradient(transparent,rgba(0,0,0,.4));transition:.6s}.popular-title-sign span{font:700 1.85rem "Alexandria",sans-serif;line-height:1;letter-spacing:-.035em;white-space:nowrap}.popular-title-sign:hover{background:#000;border-radius:0}.popular-heading p{max-width:680px;margin:10px 0 0;color:var(--muted);line-height:1.8}.popular-body{direction:ltr;display:grid;grid-template-columns:minmax(680px,1fr) 470px;align-items:center;justify-content:space-between;gap:clamp(18px,2vw,34px)}.search-grid{direction:rtl;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));justify-content:start;align-items:center;gap:80px clamp(12px,1.4vw,24px);padding:55px 0 35px}.search-grid :global(.button){width:100%;max-width:190px;justify-self:center}.cube-stage{direction:ltr;position:relative;min-height:690px;display:grid;place-items:center;overflow:visible}.cube-motion{width:470px;height:590px;display:grid;place-items:center;transform-origin:50% 50%;will-change:transform}.cube-container{position:relative;top:-80px;width:440px;height:500px;transform:skewY(-20deg) scale(1.12);transform-origin:center;animation:animate 5s linear infinite}.cube{position:relative;z-index:2;left:50%;top:43%}.cube:nth-child(2){z-index:1;translate:-60px -60px}.cube:nth-child(3){z-index:3;translate:60px 60px}.cube div{position:absolute;display:flex;flex-direction:column;gap:30px;translate:calc(-70px * var(--x)) calc(-60px * var(--y))}.cube span{position:relative;display:inline-block;width:50px;height:50px;background:#dcdcdc;z-index:calc(1 * var(--i));transition:1.5s}.cube span:hover{transition:0s;background:#ef4149;filter:drop-shadow(0 0 30px #ef4149)}.cube span::before{content:"";position:absolute;left:-40px;width:40px;height:100%;background:#fff;transform-origin:right;transform:skewY(45deg);transition:1.5s}.cube span::after{content:"";position:absolute;top:-40px;left:0;width:100%;height:40px;background:#f2f2f2;transform-origin:bottom;transform:skewX(45deg);transition:1.5s}.cube span:hover::before,.cube span:hover::after{transition:0s;background:#ef4149}@keyframes animate{0%{filter:hue-rotate(0deg)}100%{filter:hue-rotate(360deg)}}@keyframes popularFlicker{0%,41.99%,43.01%,47.99%,49.01%,100%{opacity:1}42%,43%,48%,49%{opacity:0}}
@media(max-width:1180px){.popular-body{grid-template-columns:minmax(600px,1fr) 390px}.cube-stage{min-height:620px}.cube-motion{width:390px;transform-origin:center}.cube-container{transform:skewY(-20deg) scale(.9)}.search-grid{gap:68px 10px}.search-grid :global(.button){max-width:165px}}
@media(max-width:900px){.popular-body{grid-template-columns:1fr}.cube-stage{grid-row:1}.search-grid{grid-template-columns:repeat(4,minmax(145px,1fr));justify-content:center}.search-grid :global(.button){max-width:180px}}
@media(max-width:680px){.popular{padding:90px 0 130px}.popular-heading{text-align:start;justify-items:start;margin-bottom:35px}.cube-stage{min-height:500px}.cube-motion{width:100%;height:480px}.cube-container{transform:skewY(-20deg) scale(.68)}.search-grid{width:660px;grid-template-columns:repeat(4,150px);gap:64px 20px;transform:scale(.54);transform-origin:top left;margin-bottom:-300px}}
</style>
