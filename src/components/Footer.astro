---
const { lang = "ar", prefix = "" } = Astro.props;
---
<footer>
  <div class="container footer-inner">
    <a id="footer-home" href={`${prefix}/`}><img src="/assets/brand/caesar-wordmark.png" width="4000" height="4000" loading="lazy" alt="CAESAR STUDIO" /></a>
    <span class="mono">CAESAR STUDIO © 2026</span>
    <nav aria-label="Footer"><a id="footer-services" href={`${prefix}/services/`}>{lang === "ar" ? "الخدمات" : "Services"}</a><a href={`${prefix}/locations/`}>{lang === "ar" ? "الأسواق" : "Markets"}</a><a href={`${prefix}/prices/`}>{lang === "ar" ? "الأسعار" : "Pricing"}</a><a id="footer-work" href={`${prefix}/work/`}>{lang === "ar" ? "الأعمال" : "Work"}</a></nav>
  </div>
</footer>
<style>
  footer{padding:34px 0;border-top:1px solid var(--line);background:var(--surface)}
  .footer-inner{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:30px;font-size:9px;color:var(--muted)}
  .footer-inner>a{width:150px;height:44px;overflow:hidden;display:grid;place-items:center}img{width:150px;height:44px;object-fit:contain;transform:scale(2.65);filter:invert(1) brightness(2)}[data-theme="light"] img{filter:none}
  nav{display:flex;justify-content:flex-end;gap:18px}nav a{color:var(--muted);text-decoration:none}nav a:hover{color:var(--text)}
  @media(max-width:720px){.footer-inner{grid-template-columns:1fr;text-align:center}.footer-inner>a{margin:auto}nav{justify-content:center}}
</style>
